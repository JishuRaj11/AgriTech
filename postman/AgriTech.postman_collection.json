{
  "info": {
    "_postman_id": "b7f4f0f2-3a1e-4c7e-9f3a-agritech0001",
    "name": "AgriTech API",
    "description": "REST API collection for the AgriTech MERN application.\n\n1. Run `npm run seed` in the server folder.\n2. Log in with **Login (Admin)** or **Login (Farmer)** to populate `{{token}}`.\n3. Create a farm, then a crop, then analyze soil; ids are saved automatically.\n\nDemo accounts:\n- admin@agritech.com / Admin@123\n- farmer@agritech.com / Farmer@123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "targetUserId", "value": "" },
    { "key": "farmId", "value": "" },
    { "key": "cropId", "value": "" },
    { "key": "reportId", "value": "" },
    { "key": "resourceId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "consultationId", "value": "" },
    { "key": "pestId", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "commentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
        "description": "Public health check."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Farmer\",\n  \"email\": \"newfarmer@example.com\",\n  \"password\": \"Secret123\",\n  \"location\": \"Coimbatore, Tamil Nadu\",\n  \"language\": \"en\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Public registration. Always creates a farmer account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  pm.collectionVariables.set('userId', json.user._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Admin)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@agritech.com\",\n  \"password\": \"Admin@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Logs in as the seeded admin and saves the JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logged in', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('userId', json.user._id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Farmer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
